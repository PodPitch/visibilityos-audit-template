{
  "manifest_version": 3,
  "name": "VisibilityOS Citation Capture",
  "version": "1.0.0",
  "description": "Save a selected source passage and its page URL as a local AI citation evidence record.",
  "homepage_url": "https://podpitch.github.io/visibilityos-audit-template/chrome-citation-capture/",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "VisibilityOS Citation Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  }
}
